---
interface Props { kind: 'management' | 'relationship' | 'causes' }
const {kind}=Astro.props;
const causes=[['現場の業務上の課題','もっと便利に、効率的に仕事をしたい'],['会社の提供環境とのギャップ','必要な機能がない・申請に時間がかかる'],['従業員が独自にツールを利用',''],['シャドーIT・シャドーAIの発生','組織の管理が及ばない利用環境']];
---
{kind==='management' && <figure class="frame"><svg viewBox="0 0 340 285" role="img" aria-label="承認済みサービスは会社がアクセス、情報、利用記録を管理する。未承認サービスでは管理が及ばない可能性がある。"><defs><marker id="shadowGreen" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 Z" fill="#438e70"/></marker><marker id="shadowRed" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 Z" fill="#cf6455"/></marker></defs>
<rect x="9" y="7" width="322" height="165" rx="9" fill="#438e70" fill-opacity=".06" stroke="#438e70" stroke-dasharray="5 3"/><text x="170" y="28" text-anchor="middle" font-size="13" font-weight="bold" fill="currentColor">会社の管理範囲</text>
<rect x="22" y="48" width="83" height="47" rx="5" fill="#438e70" fill-opacity=".12" stroke="#438e70"/><text x="63.5" y="75" font-size="11" text-anchor="middle" fill="currentColor">従業員</text><path d="M105 71 H127" stroke="#438e70" fill="none" stroke-width="1.5" marker-end="url(#shadowGreen)"/>
<rect x="129" y="48" width="185" height="47" rx="5" fill="#438e70" fill-opacity=".12" stroke="#438e70"/><text x="221.5" y="75" font-size="12" text-anchor="middle" fill="currentColor">承認済みサービス</text>
{['アクセス管理','情報の管理','利用記録'].map((label,i)=><g><rect x={23+i*99} y="117" width="91" height="33" rx="4" fill="#438e70" fill-opacity=".08" stroke="#438e70" stroke-opacity=".5"/><text x={68.5+i*99} y="137" text-anchor="middle" font-size="10" fill="currentColor">{label}</text></g>)}
<path d="M64 95 V236 H121" fill="none" stroke="#cf6455" stroke-width="1.8" stroke-dasharray="5 3" marker-end="url(#shadowRed)"/><text x="76" y="197" font-size="11" fill="currentColor">管理範囲の外へ</text><rect x="124" y="210" width="207" height="62" rx="6" fill="#cf6455" fill-opacity=".1" stroke="#cf6455"/><text x="227.5" y="233" text-anchor="middle" font-size="13" fill="currentColor" font-weight="bold">シャドーIT</text><text x="227.5" y="252" text-anchor="middle" font-size="10" fill="currentColor">個人アカウント・未承認サービス</text>
</svg><figcaption>シャドーITでは、会社が業務情報の取り扱いを管理できなくなる可能性がある。</figcaption></figure>}
{kind==='relationship' && <figure class="frame"><svg viewBox="0 0 340 220" role="img" aria-label="シャドーITの中にシャドーAIが含まれる"><rect x="8" y="8" width="324" height="204" rx="12" fill="#588fba" fill-opacity=".06" stroke="#588fba" stroke-width="1.5"/><text x="170" y="33" font-size="15" font-weight="bold" text-anchor="middle" fill="currentColor">シャドーIT</text>
{['クラウドストレージ','チャットサービス','私物のデバイス','未承認ソフトウェア'].map((item,i)=><g><rect x={23+(i%2)*150} y={47+Math.floor(i/2)*32} width="144" height="25" rx="4" fill="#588fba" fill-opacity=".12"/><text x={95+(i%2)*150} y={63+Math.floor(i/2)*32} font-size="10" text-anchor="middle" fill="currentColor">{item}</text></g>)}
<rect x="23" y="117" width="294" height="80" rx="8" fill="#9878c0" fill-opacity=".12" stroke="#9878c0" stroke-width="1.4"/><text x="170" y="142" font-size="14" font-weight="bold" text-anchor="middle" fill="currentColor">シャドーAI</text><text x="170" y="165" font-size="11" text-anchor="middle" fill="currentColor">生成AI・AI翻訳・AI議事録</text><text x="170" y="181" font-size="11" text-anchor="middle" fill="currentColor">AIコーディングツールなど</text></svg><figcaption>シャドーITとシャドーAIの包含関係（いずれも管理外の業務利用）。</figcaption></figure>}
{kind==='causes' && <figure class="frame"><ol class="flow">{causes.map(([label,detail],i)=><li class:list={['step',{warning:i===3}]}><strong>{label}</strong>{detail&&<small>{detail}</small>}</li>)}</ol><figcaption>シャドーITやシャドーAIが発生する背景の一例。</figcaption></figure>}
<style>
.frame{margin-block:1rem;padding:1rem;border:1px solid var(--sl-color-gray-5);border-radius:.65rem}
svg{width:100%;height:auto;display:block;max-width:32rem;margin-inline:auto}
figcaption{text-align:center;color:var(--sl-color-gray-2);font-size:.82rem;margin-top:.65rem;line-height:1.5}
.flow{list-style:none;padding:0;display:grid;gap:1.5rem;margin:0 auto;max-width:29rem}
.step{display:grid;gap:.2rem;text-align:center;padding:.8rem;border:1px solid var(--sl-color-gray-5);border-radius:.5rem;position:relative;margin:0;background:var(--sl-color-gray-6)}
.step:not(:last-child)::after{content:'↓';position:absolute;left:50%;bottom:-1.5rem;color:var(--sl-color-gray-2);font-size:1rem}
.step.warning{border-color:#cf6455;background:transparent}
small{color:var(--sl-color-gray-2);font-size:.8rem}
</style>
